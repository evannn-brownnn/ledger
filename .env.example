# Copy to .env. Every value is optional; these are the defaults.
# Validated at startup by app/config.py, so a typo fails loudly and early.

LEDGER_ENVIRONMENT=local
LEDGER_DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger

# Pool sizing. Total connections across all workers must stay below
# Postgres max_connections (default 100).
LEDGER_DB_POOL_SIZE=10
LEDGER_DB_MAX_OVERFLOW=5
LEDGER_DB_ECHO=false

# Retries for SQLSTATE 40001 serialization failures.
LEDGER_DB_SERIALIZATION_RETRIES=3

LEDGER_LOG_LEVEL=DEBUG
LEDGER_LOG_JSON=false
LEDGER_METRICS_ENABLED=true

LEDGER_DOCS_ENABLED=true
LEDGER_SUPPORTED_CURRENCIES=["USD"]
